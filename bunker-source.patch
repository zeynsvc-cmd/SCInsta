new file mode 100644
index 0000000..fffa0a7
--- /dev/null
+++ b/src/Features/General/FollowBack.x
@@ -0,0 +1,268 @@
+#import "../../InstagramHeaders.h"
+#import <objc/runtime.h>
+
+@interface IGProfileViewController : UIViewController
+- (IGUser *)user;
+@end
+
+@interface IGUser (BunkerFollowBack)
+- (id)pk;
+@end
+
+@interface IGWindow (BunkerFollowBack)
+- (id)pk;
+@end
+
+@interface IGUserListNetworkDataSource : NSObject
+- (instancetype)initWithUserSession:(IGUserSession *)session fetchPath:(NSString *)path endpointLoggingIdentifier:(NSString *)identifier;
+@property (nonatomic, weak) id delegate;
+- (void)fetchData;
+- (void)fetchMoreData;
+- (BOOL)moreAvailable;
+- (id)allResults;
+- (NSString *)maxID;
+@end
+
+@interface BunkerFollowBackController : UITableViewController
+- (instancetype)initWithSession:(IGUserSession *)session userID:(NSString *)userID;
+- (void)loadList:(NSString *)list;
+- (void)monitorRequest:(IGUserListNetworkDataSource *)source;
+- (void)consumeList:(IGUserListNetworkDataSource *)source;
+- (void)dataSourceDidFailLoad:(IGUserListNetworkDataSource *)source;
+@end
+
+@implementation BunkerFollowBackController {
+    IGUserSession *_session;
+    NSString *_userID;
+    IGUserListNetworkDataSource *_source;
+    NSSet<NSString *> *_followers;
+    NSArray<NSString *> *_results;
+    NSMutableSet<NSString *> *_pageCursors;
+    NSUInteger _requestGeneration;
+}
+
+- (instancetype)initWithSession:(IGUserSession *)session userID:(NSString *)userID {
+    self = [super initWithStyle:UITableViewStylePlain];
+    if (self) {
+        _session = session;
+        _userID = [userID copy];
+        self.title = @"Geri takip etmeyenler";
+    }
+    return self;
+}
+
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemDone target:self action:@selector(close)];
+    [self loadList:@"followers"];
+}
+
+- (void)close {
+    _source.delegate = nil;
+    _source = nil;
+    [self dismissViewControllerAnimated:YES completion:nil];
+}
+
+- (void)showStatus:(NSString *)text {
+    UILabel *label = [[UILabel alloc] init];
+    label.text = text;
+    label.textAlignment = NSTextAlignmentCenter;
+    label.textColor = UIColor.secondaryLabelColor;
+    label.numberOfLines = 0;
+    self.tableView.backgroundView = label;
+}
+
+- (void)loadList:(NSString *)list {
+    _source.delegate = nil;
+    _pageCursors = [NSMutableSet set];
+    Class sourceClass = objc_lookUpClass("IGUserListNetworkDataSource");
+    SEL initializer = @selector(initWithUserSession:fetchPath:endpointLoggingIdentifier:);
+    if (![sourceClass instancesRespondToSelector:initializer] ||
+        ![sourceClass instancesRespondToSelector:@selector(allResults)] ||
+        ![sourceClass instancesRespondToSelector:@selector(moreAvailable)] ||
+        ![sourceClass instancesRespondToSelector:@selector(fetchMoreData)] ||
+        ![sourceClass instancesRespondToSelector:@selector(fetchData)] ||
+        ![sourceClass instancesRespondToSelector:@selector(maxID)] ||
+        ![sourceClass instancesRespondToSelector:@selector(setDelegate:)]) {
+        [self showStatus:@"Bu Instagram sürümünde takip listesi yüklenemiyor."];
+        return;
+    }
+    NSString *path = [NSString stringWithFormat:@"/friendships/%@/%@/", _userID, list];
+    _source = [[sourceClass alloc] initWithUserSession:_session fetchPath:path endpointLoggingIdentifier:list];
+    if (!_source) {
+        [self showStatus:@"Takip listesi yüklenemedi."];
+        return;
+    }
+    _source.delegate = self;
+    [self showStatus:_followers ? @"Takip ettiklerin yükleniyor…" : @"Takipçilerin yükleniyor…"];
+    [self monitorRequest:_source];
+    [_source fetchData];
+}
+
+- (void)monitorRequest:(IGUserListNetworkDataSource *)source {
+    NSUInteger generation = ++_requestGeneration;
+    __weak BunkerFollowBackController *weakSelf = self;
+    __weak IGUserListNetworkDataSource *weakSource = source;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        BunkerFollowBackController *controller = weakSelf;
+        if (controller && weakSource && controller->_requestGeneration == generation) {
+            [controller dataSourceDidFailLoad:weakSource];
+        }
+    });
+}
+
+- (void)dataSourceDidStartLoading:(IGUserListNetworkDataSource *)source {
+}
+
+- (void)dataSourceDidFailLoad:(IGUserListNetworkDataSource *)source {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (source != self->_source) return;
+        source.delegate = nil;
+        self->_source = nil;
+        [self showStatus:@"Takip listesi yüklenemedi. Daha sonra tekrar dene."];
+    });
+}
+
+- (void)dataSourceDidFinishLoading:(IGUserListNetworkDataSource *)source {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (source != self->_source) return;
+        self->_requestGeneration++;
+        [self consumeList:source];
+    });
+}
+
+- (void)consumeList:(IGUserListNetworkDataSource *)source {
+    if (source.moreAvailable) {
+        NSString *cursor = source.maxID;
+        if (![cursor isKindOfClass:[NSString class]] || !cursor.length || [_pageCursors containsObject:cursor]) {
+            [self dataSourceDidFailLoad:source];
+            return;
+        }
+        [_pageCursors addObject:cursor];
+        [self monitorRequest:source];
+        [source fetchMoreData];
+        return;
+    }
+
+    id rows = source.allResults;
+    if ([rows isKindOfClass:[NSOrderedSet class]]) rows = [rows array];
+    if (![rows isKindOfClass:[NSArray class]]) {
+        [self dataSourceDidFailLoad:source];
+        return;
+    }
+    NSMutableDictionary<NSString *, NSString *> *names = [NSMutableDictionary dictionary];
+    for (id row in rows) {
+        id user = row;
+        if (![user respondsToSelector:@selector(username)] && [row respondsToSelector:@selector(user)]) {
+            user = [row user];
+        }
+        NSString *name = [user respondsToSelector:@selector(username)] ? [user username] : nil;
+        if (![name isKindOfClass:[NSString class]] || !name.length) {
+            [self dataSourceDidFailLoad:source];
+            return;
+        }
+        names[name.lowercaseString] = name;
+    }
+
+    if (!_followers) {
+        _followers = [NSSet setWithArray:names.allKeys];
+        [self loadList:@"following"];
+        return;
+    }
+    NSMutableArray<NSString *> *missing = [NSMutableArray array];
+    for (NSString *name in names) {
+        if (![_followers containsObject:name]) [missing addObject:names[name]];
+    }
+    _results = [missing sortedArrayUsingSelector:@selector(localizedCaseInsensitiveCompare:)];
+    source.delegate = nil;
+    _source = nil;
+    if (_results.count) {
+        self.tableView.backgroundView = nil;
+    } else {
+        [self showStatus:@"Takip ettiğin herkes seni geri takip ediyor."];
+    }
+    [self.tableView reloadData];
+}
+
+- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {
+    return _results.count;
+}
+
+- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath {
+    UITableViewCell *cell = [tableView dequeueReusableCellWithIdentifier:@"BunkerFollowBackUser"];
+    if (!cell) cell = [[UITableViewCell alloc] initWithStyle:UITableViewCellStyleDefault reuseIdentifier:@"BunkerFollowBackUser"];
+    cell.textLabel.text = [@"@" stringByAppendingString:_results[indexPath.row]];
+    cell.selectionStyle = UITableViewCellSelectionStyleNone;
+    return cell;
+}
+
+@end
+
+static NSString *BunkerUserID(id value) {
+    if ([value isKindOfClass:[NSNumber class]]) value = [value stringValue];
+    if (![value isKindOfClass:[NSString class]] || ![value length] ||
+        [value rangeOfCharacterFromSet:[[NSCharacterSet characterSetWithCharactersInString:@"0123456789"] invertedSet]].location != NSNotFound) return nil;
+    return value;
+}
+
+static IGProfileViewController *BunkerProfileController(UIView *view) {
+    Class profileClass = objc_lookUpClass("IGProfileViewController");
+    for (UIResponder *responder = view.nextResponder; responder; responder = responder.nextResponder) {
+        if ([responder isKindOfClass:profileClass]) return (IGProfileViewController *)responder;
+    }
+    return nil;
+}
+
+static char BunkerPendingFollowersTap;
+
+%group BunkerFollowBack435
+%hook _TtC23IGProfileHeaderIdentity38IGProfileHeaderStatButtonContainerView
+- (void)didTapFollowers {
+    UIView *view = (UIView *)self;
+    IGProfileViewController *profile = BunkerProfileController(view);
+    IGWindow *window = (IGWindow *)view.window;
+    IGUserSession *session = [window respondsToSelector:@selector(userSession)] ? window.userSession : nil;
+    IGUser *account = session.user;
+    IGUser *profileUser = [profile respondsToSelector:@selector(user)] ? profile.user : nil;
+    NSString *userID = BunkerUserID([account respondsToSelector:@selector(pk)] ? account.pk : nil);
+    if (!userID && [window respondsToSelector:@selector(pk)]) userID = BunkerUserID(window.pk);
+    NSString *profileID = BunkerUserID([profileUser respondsToSelector:@selector(pk)] ? profileUser.pk : nil);
+    NSString *profileName = [profileUser respondsToSelector:@selector(username)] ? profileUser.username : nil;
+    NSString *accountName = [account respondsToSelector:@selector(username)] ? account.username : nil;
+    BOOL isOwnProfile = profileID ? [userID isEqualToString:profileID] :
+        (profileName.length && accountName.length && [profileName caseInsensitiveCompare:accountName] == NSOrderedSame);
+    if (!profile || !userID || !session || !isOwnProfile || UIAccessibilityIsVoiceOverRunning()) {
+        %orig;
+        return;
+    }
+
+    id pending = objc_getAssociatedObject(self, &BunkerPendingFollowersTap);
+    if (pending) {
+        objc_setAssociatedObject(self, &BunkerPendingFollowersTap, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        if (!profile.presentedViewController) {
+            BunkerFollowBackController *controller = [[BunkerFollowBackController alloc] initWithSession:session userID:userID];
+            UINavigationController *navigation = [[UINavigationController alloc] initWithRootViewController:controller];
+            [profile presentViewController:navigation animated:YES completion:nil];
+        }
+        return;
+    }
+
+    NSObject *token = [[NSObject alloc] init];
+    objc_setAssociatedObject(self, &BunkerPendingFollowersTap, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 320 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        if (objc_getAssociatedObject(self, &BunkerPendingFollowersTap) != token) return;
+        objc_setAssociatedObject(self, &BunkerPendingFollowersTap, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        if (view.window && BunkerProfileController(view) == profile) {
+            %orig;
+        }
+    });
+}
+%end
+%end
+
+%ctor {
+    Class stats = objc_lookUpClass("_TtC23IGProfileHeaderIdentity38IGProfileHeaderStatButtonContainerView");
+    if (class_getInstanceMethod(stats, @selector(didTapFollowers))) {
+        %init(BunkerFollowBack435);
+    }
+}
